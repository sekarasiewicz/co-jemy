DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=your-secret-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Registration is invite-only; the code is checked server-side at sign-up.
INVITE_CODE=your-invite-code-here
GEMINI_API_KEY=your-gemini-api-key-here
# Vercel Blob (meal/ingredient/profile images)
BLOB_READ_WRITE_TOKEN=your-blob-token-here
# Optional: per-user daily AI spend cap in USD (default 2)
AI_DAILY_BUDGET_USD=2
